import numpy as np
import matplotlib.pyplot as plt
from matplotlib.ticker import MultipleLocator

# Dados da onda
frequencia = float(input("Digite a frequência (Hz): "))
amplitude = 1

# Período em segundos
periodo = 1 / frequencia

if frequencia > 200:
    tempo = np.linspace(0, 12 * periodo, 1000)
else:tempo = np.linspace(0, 4 * periodo, 1000)

# Onda senoidal
onda = amplitude * np.sin(2 * np.pi * frequencia * tempo)

# Converter tempo para milissegundos
tempo_ms = tempo * 1000

# Criar gráfico
plt.figure(figsize=(20, 10))

plt.plot(tempo_ms, onda)

# Linha centralw
plt.axhline(0, linestyle="--")

# Marcar máximo e mínimo (no caso, +1 e -1))
plt.axhline(amplitude, linestyle=":")
plt.axhline(-amplitude, linestyle=":")

# Marcar um período
plt.axvline(periodo * 1000, linestyle="--")

# Textos
plt.text(periodo * 1000, 1.05, f"1 período = {periodo * 1000:.2f} ms",
         ha="center")

# Linhas dos períodos
for i in range(1, 10):
    x = i * periodo * 1000
    plt.axvline(x, linestyle="--", alpha=0.4)

# Destaque do primeiro período
plt.annotate(
    "",
    xy=(periodo * 1000, -1.2),
    xytext=(0, -1.2),
    arrowprops=dict(arrowstyle="<->")
)

plt.text(
    periodo * 500,
    -1.35,
    f"P = {periodo * 1000:.2f} ms",
    ha="center"
)

# Títulos
plt.title(f"Onda senoidal — {frequencia:.2f} Hz | f(t) = sen(2π * {frequencia:.2f} * t)")
plt.xlabel("Tempo (ms)")
plt.ylabel("Amplitude")
plt.text(
    0.5, -0.18,
    f"Máximo = {amplitude:.2f}    |    Mínimo = {-amplitude:.2f} |  periodo = {periodo * 1000:.2f} ms",
    transform=plt.gca().transAxes,
    ha="center"
)
plt.gca().xaxis.set_major_locator(MultipleLocator(10))

plt.grid(axis="x")
plt.tight_layout()

plt.show()
