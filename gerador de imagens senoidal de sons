import numpy as np
import matplotlib.pyplot as plt

# Dados da onda
frequencia = 261.63  # Hz
amplitude = 1

# Período em segundos
periodo = 1 / frequencia

# Tempo de 0 até 2 períodos
tempo = np.linspace(0, 2 * periodo, 1000)

# Onda senoidal
onda = amplitude * np.sin(2 * np.pi * frequencia * tempo)

# Converter tempo para milissegundos
tempo_ms = tempo * 1000

# Criar gráfico
plt.figure(figsize=(12, 5))

plt.plot(tempo_ms, onda)

# Linha central
plt.axhline(0, linestyle="--")

# Marcar máximo e mínimo
plt.axhline(amplitude, linestyle=":")
plt.axhline(-amplitude, linestyle=":")

# Marcar um período
plt.axvline(periodo * 1000, linestyle="--")

# Textos
plt.text(periodo * 1000, 1.05, "1 período = 3,82 ms",
         ha="center")

plt.text(0.1, 1.02, "Máximo = +1")
plt.text(0.1, -0.98, "Mínimo = -1")

# Títulos
plt.title("Onda senoidal — 261,63 Hz")
plt.xlabel("Tempo (ms)")
plt.ylabel("Amplitude")

plt.grid(True)
plt.tight_layout()

plt.show()
